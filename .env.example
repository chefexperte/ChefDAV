# ChefDAV build-time configuration — copy to `.env` in the repository root.
#
# Trunk reads `.env` automatically on `trunk build` / `trunk serve` and passes
# these values into the WASM bundle. They are **compile-time** settings: the app
# is a static bundle with no backend that could read them at runtime.

# The CalDAV server the app talks to, locked in.
# When set, the login screen shows it read-only — nobody can point the app at
# another server (a previously saved login cannot override it either).
# Leave empty/unset to let users type their own server URL on the login screen.
# BACKEND_URL=https://dav.example.org

# Optional: a pre-filled but *editable* server URL (older name, still used by
# the stable instance). BACKEND_URL wins when both are set.
# CHEFDAV_DAV_URL=https://dav.example.org
