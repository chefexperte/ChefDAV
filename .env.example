# ChefDAV configuration — copy to `.env` in the repository root (or next to
# docker/docker-compose.prod.yml) and edit.
#
# ── Container / compose (runtime, change any time) ───────────────────────────
# The image reads these on every start (docker/container-entrypoint.sh writes
# them into /srv-runtime/config.json, which the app fetches before it renders).
# Change a value and `docker compose up -d` again — no rebuild needed.

# The CalDAV server the app talks to, e.g. https://dav.example.org
# Leave empty to let users type their server on the login screen.
BACKEND_URL=

# Path the app is published under, when a reverse proxy mounts it below the
# site root (e.g. /ui on calendar.example.com). Leave empty when served at "/".
BASE_PATH=

# ── Local builds (compile time) ──────────────────────────────────────────────
# Only for `trunk build` / `trunk serve` without Docker (e.g. hosting dist/
# yourself). The app is static, so these are baked into the WASM bundle; the
# container path above does not need them.

# Pre-filled, still editable server URL for a local build.
# CHEFDAV_DAV_URL=https://dav.example.org

# Fixed server URL for a local build (no server field on the login screen).
# BACKEND_URL=https://dav.example.org
